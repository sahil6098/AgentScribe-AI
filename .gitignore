# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.Python

# Virtual environments
.venv/
venv/
env/
ENV/

# Python packaging and test/tool caches
build/
dist/
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
htmlcov/
.coverage
.coverage.*
coverage.xml

# Local configuration and credentials
.env
.env.*
!.env.example
*.pem
*.key

# Logs and temporary files
*.log
*.tmp
*.bak

# Terraform working data and generated state
terraform/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars
*.tfvars.json
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Keep Terraform dependency selections and example variable files trackable.
!terraform/.terraform.lock.hcl
!terraform/*.tfvars.example
!terraform/*.auto.tfvars.example

# Editors and operating systems
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini
